# Each provider exports the same targets, including transitive headers and links.
set(VACUUM_DEPENDENCY_PROVIDER AUTO CACHE STRING "C dependencies: AUTO, SYSTEM or BUNDLED")
set_property(CACHE VACUUM_DEPENDENCY_PROVIDER PROPERTY STRINGS AUTO SYSTEM BUNDLED)
string(TOUPPER "${VACUUM_DEPENDENCY_PROVIDER}" VACUUM_DEPENDENCY_PROVIDER)
if(NOT VACUUM_DEPENDENCY_PROVIDER MATCHES "^(AUTO|SYSTEM|BUNDLED)$")
    message(FATAL_ERROR "VACUUM_DEPENDENCY_PROVIDER must be AUTO, SYSTEM or BUNDLED")
endif()

function(_vacuum_dependency_target name dependency provider)
    string(TOLOWER "${name}" lower_name)
    add_library(vacuum_${lower_name} INTERFACE)
    target_link_libraries(vacuum_${lower_name} INTERFACE ${dependency})
    add_library(Vacuum::${name} ALIAS vacuum_${lower_name})
    set_property(TARGET vacuum_${lower_name} PROPERTY VACUUM_DEPENDENCY_PROVIDER "${provider}")
    message(STATUS "${name}: ${provider} (${dependency})")
endfunction()

function(_vacuum_pkg_dependency name module bundled_directory)
    set(system_target "")
    if(NOT VACUUM_DEPENDENCY_PROVIDER STREQUAL BUNDLED)
        find_package(PkgConfig QUIET)
        if(PKG_CONFIG_FOUND)
            string(TOUPPER "${name}" prefix)
            pkg_check_modules(VACUUM_${prefix} QUIET IMPORTED_TARGET GLOBAL "${module}")
            if(TARGET PkgConfig::VACUUM_${prefix})
                set(system_target PkgConfig::VACUUM_${prefix})
                if(name STREQUAL Minizip)
                    # Some .pc files advertise include/ instead of include/minizip/.
                    find_path(VACUUM_MINIZIP_HEADER_DIR unzip.h
                        HINTS ${VACUUM_MINIZIP_INCLUDE_DIRS} PATH_SUFFIXES minizip)
                    if(NOT VACUUM_MINIZIP_HEADER_DIR)
                        set(system_target "")
                    endif()
                endif()
            endif()
        endif()
    endif()
    if(system_target)
        _vacuum_dependency_target(${name} ${system_target} SYSTEM)
        if(name STREQUAL Minizip)
            target_include_directories(vacuum_minizip SYSTEM INTERFACE "${VACUUM_MINIZIP_HEADER_DIR}")
        endif()
    elseif(VACUUM_DEPENDENCY_PROVIDER STREQUAL SYSTEM)
        message(FATAL_ERROR "System dependency '${module}' is missing; install its development package or select AUTO/BUNDLED")
    else()
        add_subdirectory("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../thirdparty/${bundled_directory}"
            "${CMAKE_BINARY_DIR}/src/thirdparty/${bundled_directory}")
        _vacuum_dependency_target(${name} ${bundled_directory} BUNDLED)
    endif()
endfunction()

function(vacuum_find_core_dependencies)
    if(NOT VACUUM_DEPENDENCY_PROVIDER STREQUAL BUNDLED)
        find_package(ZLIB QUIET)
    endif()
    if(TARGET ZLIB::ZLIB AND NOT VACUUM_DEPENDENCY_PROVIDER STREQUAL BUNDLED)
        _vacuum_dependency_target(Zlib ZLIB::ZLIB SYSTEM)
    elseif(VACUUM_DEPENDENCY_PROVIDER STREQUAL SYSTEM)
        message(FATAL_ERROR "System zlib development files are missing")
    else()
        add_subdirectory("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../thirdparty/zlib"
            "${CMAKE_BINARY_DIR}/src/thirdparty/zlib")
        _vacuum_dependency_target(Zlib zlib BUNDLED)
    endif()
    _vacuum_pkg_dependency(Minizip minizip minizip)
    target_link_libraries(vacuum_minizip INTERFACE Vacuum::Zlib)
    _vacuum_pkg_dependency(Idn libidn idn)
endfunction()

function(vacuum_find_hunspell)
    if(NOT TARGET Vacuum::Hunspell)
        _vacuum_pkg_dependency(Hunspell "hunspell>=1.6.0" hunspell)
    endif()
endfunction()
