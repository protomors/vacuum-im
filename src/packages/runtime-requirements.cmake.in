if(POLICY CMP0152)
    cmake_policy(SET CMP0152 NEW)
endif()
if(POLICY CMP0207)
    cmake_policy(SET CMP0207 NEW)
endif()
set(_prefix "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}")
set(_modules "@_installed_plugin_paths@")
list(TRANSFORM _modules PREPEND "${_prefix}/")
file(GET_RUNTIME_DEPENDENCIES
    EXECUTABLES "${_prefix}/@INSTALL_BINS@/$<TARGET_FILE_NAME:@VACUUM_LOADER_NAME@>"
    MODULES ${_modules}
    RESOLVED_DEPENDENCIES_VAR _resolved
    UNRESOLVED_DEPENDENCIES_VAR _unresolved)
if(_unresolved)
    message(FATAL_ERROR "Unresolved installed runtime dependencies: ${_unresolved}")
endif()
set(_text "Vacuum-IM @PROJECT_VERSION@ (@GIT_HASH@)\n\n")
string(APPEND _text "Build system: @_os_release@ (@CMAKE_SYSTEM_PROCESSOR@)\n")
string(APPEND _text "Qt: @Qt6Core_VERSION@\nC runtime: @_libc_version@\n")
string(APPEND _text "C++ compiler: @CMAKE_CXX_COMPILER_ID@ @CMAKE_CXX_COMPILER_VERSION@\n")
string(APPEND _text "GStreamer: @VACUUM_GSTREAMER_VERSION@\n\n")
string(APPEND _text "This archive uses system shared libraries. It does not include Qt or GStreamer.\n")
string(APPEND _text "The versions above describe this build, rather than a universal minimum.\n")
string(APPEND _text "Qt native interfaces are outside Qt's binary compatibility guarantee.\n\n")
string(APPEND _text "Install the matching distribution's Qt base/SVG/multimedia/platform plugins,\n")
string(APPEND _text "TLS and SQLite plugins, and GStreamer base/good/bad/nice/Opus plugins.\n")
string(APPEND _text "Keep bin/, lib/ and share/ together; start bin/vacuum after extraction.\n\n")
string(APPEND _text "Resolved shared libraries (excluding Vacuum's bundled library):\n")
foreach(dependency IN LISTS _resolved)
    string(FIND "${dependency}" "${_prefix}/" _own_library)
    if(NOT _own_library EQUAL 0)
        get_filename_component(_soname "${dependency}" NAME)
        file(REAL_PATH "${dependency}" _real)
        get_filename_component(_versioned_name "${_real}" NAME)
        string(APPEND _text "  ${_soname} -> ${_versioned_name}\n")
    endif()
endforeach()
file(WRITE "${_prefix}/@INSTALL_DOCUMENTS@/RUNTIME-REQUIREMENTS.txt" "${_text}")
