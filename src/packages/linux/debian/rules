#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

# Extra CMake arguments, e.g. VACUUM_CMAKE_ARGS="-DGIT_HASH=... -DGIT_DATE=..."
VACUUM_CMAKE_ARGS ?=

%:
	dh $@ --buildsystem=cmake+ninja

override_dh_auto_configure:
	dh_auto_configure -- \
		-DVACUUM_DEPENDENCY_PROVIDER=SYSTEM \
		-DPLUGIN_voicecalls=ON \
		-DSPELLCHECKER_BACKEND=HUNSPELL \
		-DINSTALL_SDK=OFF \
		-DINSTALL_DOCS=OFF \
		-DINSTALL_ARCHIVE_INFO=OFF \
		$(VACUUM_CMAKE_ARGS)

# There are no regression tests in the default build (BUILD_TESTING=OFF).
override_dh_auto_test:

override_dh_auto_install:
	dh_auto_install
	# Development symlink; the plugin SDK is not packaged.
	rm -f debian/vacuum-im/usr/lib/libvacuumutils.so

override_dh_makeshlibs:
	# libvacuumutils is private to the application.
	dh_makeshlibs --no-scripts -X/usr/lib/vacuum/plugins

override_dh_shlibdeps:
	dh_shlibdeps -l$(CURDIR)/debian/vacuum-im/usr/lib
