# Maintainer: protomors <protomors@users.noreply.github.com>
#
# CI builds this from a `git archive` tarball of the checkout
# (.github/scripts/build-arch-package.sh), which also sets pkgver.
# For AUR, point source at a release tarball and add its checksum.

pkgname=vacuum-im
pkgver=1.3.0alpha
pkgrel=1
pkgdesc='Full-featured Jabber/XMPP client'
arch=('x86_64')
url='https://github.com/protomors/vacuum-im'
license=('GPL-3.0-only')
depends=(
  'qt6-base'
  'qt6-svg'
  'qt6-multimedia'
  'qt6-multimedia-ffmpeg'
  'hunspell'
  'libidn'
  'minizip'
  'zlib'
  'libx11'
  'libxss'
  'gstreamer'
  'gst-plugins-base'
  'gst-plugins-base-libs'
  'gst-plugins-good'
  'gst-plugins-bad'
  'gst-plugins-bad-libs'
  'libnice'
)
makedepends=('cmake' 'ninja' 'qt6-tools')
optdepends=(
  'qt6-wayland: native Wayland support'
  'hunspell-en_us: English spell checking dictionary'
)
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cmake -S "$pkgname-$pkgver" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DVACUUM_DEPENDENCY_PROVIDER=SYSTEM \
    -DPLUGIN_voicecalls=ON \
    -DSPELLCHECKER_BACKEND=HUNSPELL \
    -DINSTALL_SDK=OFF \
    -DINSTALL_ARCHIVE_INFO=OFF \
    -DGIT_HASH="${VACUUM_GIT_HASH:-}" \
    -DGIT_DATE="${VACUUM_GIT_DATE:-}"
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  # Development symlink; the plugin SDK is not packaged.
  rm -f "$pkgdir/usr/lib/libvacuumutils.so"
  install -Dm644 "$pkgname-$pkgver/src/packages/linux/vacuum.1" \
    "$pkgdir/usr/share/man/man1/vacuum.1"
}
